@model IEnumerable<RoomMates.Models.DBModel.ViewBill>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "View Bill Details";
    int? selectedMonth = ViewData["SelectedMonth"] as int?;
    var months = new List<SelectListItem>
    {
        new SelectListItem { Text = "January", Value = "1" },
        new SelectListItem { Text = "February", Value = "2" },
        new SelectListItem { Text = "March", Value = "3" },
        new SelectListItem { Text = "April", Value = "4" },
        new SelectListItem { Text = "May", Value = "5" },
        new SelectListItem { Text = "June", Value = "6" },
        new SelectListItem { Text = "July", Value = "7" },
        new SelectListItem { Text = "August", Value = "8" },
        new SelectListItem { Text = "September", Value = "9" },
        new SelectListItem { Text = "October", Value = "10" },
        new SelectListItem { Text = "November", Value = "11" },
        new SelectListItem { Text = "December", Value = "12" }
    };
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">User Bill Summary</h2>
     </div>

    <form method="get" class="mb-3 row g-2 align-items-center">
        <div class="col-auto">
            <label for="monthFilter" class="form-label fw-bold">Filter by Month:</label>
        </div>
        <div class="col-auto">
            <select name="month" id="monthFilter" class="form-select">
                <option value="">-- All Months --</option>
                @foreach (var month in months)
                {
                    var isSelected = selectedMonth.HasValue && selectedMonth.Value.ToString() == month.Value;
                    <option value="@month.Value" selected="@(isSelected ? "selected" : null)">
                        @month.Text
                    </option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.First().Month)</th>
                        <th>@Html.DisplayNameFor(m => m.First().Name)</th>
                        <th>@Html.DisplayNameFor(m => m.First().PayAmount)</th>
                        <th>@Html.DisplayNameFor(m => m.First().UserPurchaseAmount)</th>
                        <th>@Html.DisplayNameFor(m => m.First().PayTotalAmount)</th>
                        <th>@Html.DisplayNameFor(m => m.First().AdvancePending)</th>
                        <th>@Html.DisplayNameFor(m => m.First().TotalAmountRentAdvance)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Month</td>
                                <td>@item.Name</td>
                                <td>@item.PayAmount</td>
                                <td>@item.UserPurchaseAmount</td>
                                <td>@item.PayTotalAmount</td>
                                <td>@item.AdvancePending</td>
                                <td>@item.TotalAmountRentAdvance</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-muted">No data available</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <br />
    <div class="d-flex justify-content-center mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            Back
        </a>
    </div>
</div>