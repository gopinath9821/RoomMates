@model RoomMates.Models.DBModel.UserPageViewModel
@{
    ViewData["Title"] = "Add User Details";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<!-- Add User Form -->
<div class="d-flex justify-content-center align-items-center bg-light p-4">
    <div class="card shadow-lg border-0 rounded-4 w-100" style="max-width: 720px;">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h3 class="mb-0">Add User Details</h3>
        </div>
        <div class="card-body p-4">

            <form asp-action="User" enctype="multipart/form-data" method="post" novalidate>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="User.UserName" class="form-label fw-semibold">Username</label>
                        <input asp-for="User.UserName" class="form-control" placeholder="Enter username" required />
                        <span asp-validation-for="User.UserName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="User.Password" class="form-label fw-semibold">Password</label>
                        <input asp-for="User.Password" type="password" class="form-control" placeholder="Enter password" required />
                        <span asp-validation-for="User.Password" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label asp-for="User.Name" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="User.Name" class="form-control" placeholder="Enter full name" required />
                        <span asp-validation-for="User.Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="User.DOB" class="form-label fw-semibold">Date of Birth</label>
                        <input asp-for="User.DOB" type="date" class="form-control" required />
                        <span asp-validation-for="User.DOB" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Profile Photo</label>
                        <input class="form-control" type="file" name="PhotoFile" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="User.Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="User.Email" type="email" class="form-control" placeholder="Enter email" />
                        <span asp-validation-for="User.Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label asp-for="User.MobileNo" class="form-label fw-semibold">Mobile No</label>
                        <input asp-for="User.MobileNo" class="form-control" placeholder="Enter mobile number" required />
                        <span asp-validation-for="User.MobileNo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="User.DOJ" class="form-label fw-semibold">Date of Joining</label>
                        <input asp-for="User.DOJ" type="date" class="form-control" />
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label asp-for="User.RoomAdvance" class="form-label fw-semibold">Room Advance</label>
                        <input asp-for="User.RoomAdvance" type="number" step="0.01" class="form-control" placeholder="Enter advance amount" />
                    </div>
                </div>

                <div class="mt-4 text-center d-flex justify-content-center gap-3 flex-wrap">
                    <button type="submit" class="btn btn-success px-5 shadow-sm">
                        <i class="bi bi-check-circle me-2"></i>Save User
                    </button>
                    <button type="button" class="btn btn-danger px-5 shadow-sm" onclick="window.history.back();">
                        <i class="bi bi-x-circle me-2"></i>Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Users Grid -->
<div class="container mt-5">
    <h2 class="mb-4 text-primary fw-bold">All Users</h2>

    <table class="table table-striped table-hover shadow-sm rounded">
        <thead class="table-dark">
            <tr>
                <th>UserID</th>
                <th>Username</th>
                <th>Name</th>
                <th>Email</th>
                <th>Mobile No</th>
                <th>DOB</th>
                <th>Date of Joining</th>
                <th>Room Advance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.UserID</td>
                    <td>@user.UserName</td>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.MobileNo</td>
                    <td>@(user.DOB?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "-")</td>
                    <td>@(user.DOJ?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "-")</td>

                    <td>@user.RoomAdvance.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-body text-center p-5">
                <div class="mb-3 text-success">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <h4 class="fw-bold">Success!</h4>
                <p class="text-muted">@TempData["SuccessMessage"]</p>
                <button class="btn btn-primary mt-3 px-4" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                var successModal = new bootstrap.Modal(document.getElementById('successModal'));
                successModal.show();
            }
        });
    </script>
}
